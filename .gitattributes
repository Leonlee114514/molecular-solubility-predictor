# Large model/data artifacts are stored with Git LFS.
# New commits will contain LFS pointers; run `git lfs migrate import` if you
# later want to rewrite history and remove the old large blobs entirely.
# Patterns:
#   output_v2/pka_*.pkl                  pKa RF models
#   output_v2/solubility_model_*.pkl.gz  compressed solubility RF models (v5/v6)
#   output_v2/ood_detector.pkl.gz        OOD reference stats
#   output_v2/gnn_solubility_model*.pt   PyTorch GNN checkpoints (v2-v5)
#   data/sa_fpscores.pkl.gz              synthetic-accessibility fragment scores
output_v2/pka_*.pkl filter=lfs diff=lfs merge=lfs -text
output_v2/solubility_model_*.pkl.gz filter=lfs diff=lfs merge=lfs -text
output_v2/ood_detector.pkl.gz filter=lfs diff=lfs merge=lfs -text
output_v2/gnn_solubility_model*.pt filter=lfs diff=lfs merge=lfs -text
data/sa_fpscores.pkl.gz filter=lfs diff=lfs merge=lfs -text
